diff --git a/loader.mjs b/loader.mjs
index 0a65ae4..7fe1a3a 100644
--- a/loader.mjs
+++ b/loader.mjs
@@ -1,3 +1,12 @@
 export function createLoader(fetcher) {
-  return key => fetcher(key);
+  const pending = new Map();
+  return key => {
+    if (!pending.has(key)) {
+      const request = Promise.resolve()
+        .then(() => fetcher(key))
+        .finally(() => pending.delete(key));
+      pending.set(key, request);
+    }
+    return pending.get(key);
+  };
 }
